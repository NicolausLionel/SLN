function buildMap(){
 const r=rng(20261107);
 fillR(0,0,MW-1,MH-1,T.WATER);fillR(2,2,MW-3,MH-3,T.GRASS);
 for(let x=2;x<MW-2;x++){if(r()<.4)setT(x,2,T.WATER);if(r()<.4)setT(x,MH-3,T.WATER)}
 for(let y=2;y<MH-2;y++){if(r()<.4)setT(2,y,T.WATER);if(r()<.4)setT(MW-3,y,T.WATER)}
 for(let y=3;y<MH-3;y++)for(let x=3;x<MW-3;x++)if(r()<.07)setT(x,y,T.FLOW);
 for(const k in ZONES){const z=ZONES[k];fillR(z.x0,z.y0,z.x1,z.y1,z.wall);fillR(z.x0+1,z.y0+1,z.x1-1,z.y1-1,z.floor);z.ent.forEach(([x,y])=>setT(x,y,z.floor))}
 // Origin Valley river + bridges
