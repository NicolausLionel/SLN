<!doctype html><html><head><meta charset=utf8><meta name=viewport content="width=device-width,initial-scale=1,viewport-fit=cover"><style>:root{color-scheme:light;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}html{scroll-padding-top:env(safe-area-inset-top,0px)}body{margin:0;padding:0;font:14px -apple-system,BlinkMacSystemFont,sans-serif;background:#fff;color:#000}img{max-width:100%}[hidden]:not([hidden=until-found i]){display:none!important}</style></head><body>
<title>AI QUEST Arcade</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=Inter:wght@400;600;700&display=swap">
<style>
/* Layout: an arcade cabinet — HUD strip, pixel canvas "screen", touch pad below; quiz/menus open as guide-style windows over the screen.
   Single committed dark-console look, palette lifted from Team SLN's AI QUEST study guide. */
:root{
  color-scheme: dark;
  --deep:#14162e; --navy:#1e2140; --navy-2:#2b2f57; --ink:#1a1c33; --paper:#fffaf0; --paper-2:#fff3d6;
  --yellow:#f5c542; --cyan:#5fd8e8; --red:#e8435a; --green:#3fbf6a; --white:#ffffff; --muted:#5b5f7f; --soft:#b8bbd8;
  --accent:#ef6a3a;
  --pix:"Press Start 2P", ui-monospace, "Courier New", monospace;
  --body:"Inter", system-ui, -apple-system, "Segoe UI", sans-serif;
}
[hidden]{display:none!important}
html,body{min-height:100%}
.center>svg.spr,.center>.bob>svg.spr{margin:0 auto}
body{margin:0;font-family:var(--body);color:var(--white);background-color:var(--deep);background-image:radial-gradient(#23264a 1px,transparent 1px);background-size:8px 8px}
.shell{max-width:1000px;margin:0 auto;padding-block:14px 28px;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px))}
button{font:inherit}
:focus-visible{outline:3px solid var(--cyan);outline-offset:2px}

/* HUD */
.hud{display:flex;align-items:center;gap:12px;background:var(--navy);padding:9px 12px;font-family:var(--pix);font-size:9px;border:3px solid #0c0e22;border-bottom:0;flex-wrap:wrap}
.hearts,.cores{display:flex;gap:3px;align-items:center;min-height:14px}
.where{color:var(--yellow);flex:1;text-align:center;letter-spacing:.06em;min-width:0;line-height:1.5}
.hbtns{display:flex;gap:6px}
.iconbtn{background:var(--navy-2);border:2px solid var(--white);color:var(--white);font-family:var(--pix);font-size:8px;padding:5px 7px;cursor:pointer;line-height:1}
.iconbtn:hover{background:var(--accent)}
.iconbtn[aria-pressed="false"]{opacity:.55}

/* Screen */
.stage{position:relative;border:3px solid #0c0e22;box-shadow:0 0 0 3px var(--navy),10px 10px 0 3px rgba(0,0,0,.45);background:#000;line-height:0;overflow:hidden;user-select:none;-webkit-user-select:none;touch-action:none}
#cv{width:100%;height:auto;display:block;image-rendering:pixelated;image-rendering:crisp-edges}
.banner{position:absolute;top:12px;left:50%;transform:translateX(-50%);background:var(--navy);border:3px solid var(--white);box-shadow:4px 4px 0 rgba(0,0,0,.5);padding:10px 16px;text-align:center;line-height:1.7;font-family:var(--pix);pointer-events:none;max-width:88%;animation:drop .3s steps(3)}
.banner small{display:block;font-size:8px;color:var(--soft);letter-spacing:.1em}
.banner b{display:block;font-weight:400;font-size:clamp(11px,2.2vw,16px);color:var(--yellow);letter-spacing:.08em}
.banner span{display:block;font-family:var(--body);font-size:12px;color:var(--white)}
@keyframes drop{from{transform:translate(-50%,-20px);opacity:0}}
.toast{position:absolute;top:12px;left:12px;background:var(--yellow);color:var(--navy);border:3px solid var(--navy);font-family:var(--pix);font-size:8px;line-height:1.6;padding:8px 10px;max-width:60%;box-shadow:3px 3px 0 rgba(0,0,0,.4)}
.prompt{position:absolute;left:50%;bottom:12px;transform:translateX(-50%);background:var(--navy);color:var(--white);border:3px solid var(--yellow);font-family:var(--pix);font-size:9px;line-height:1.4;padding:8px 12px;cursor:pointer;white-space:nowrap;max-width:92%;overflow:hidden;text-overflow:ellipsis;animation:pulse 1s steps(2) infinite}
.prompt b{color:var(--yellow);font-weight:400}
@keyframes pulse{50%{border-color:var(--white)}}
.dlg{position:absolute;left:10px;right:10px;bottom:10px;background:var(--paper);color:var(--ink);border:3px solid var(--navy);box-shadow:5px 5px 0 rgba(0,0,0,.45);padding:18px 16px 12px;line-height:1.5;cursor:pointer}
.dlg .nm{position:absolute;top:-13px;left:12px;background:var(--accent);color:var(--white);border:3px solid var(--navy);font-family:var(--pix);font-size:8px;padding:5px 8px;letter-spacing:.08em}
.dlg .tx{font-size:clamp(14px,1.9vw,17px);min-height:2.9em}
.dlg .more{position:absolute;right:12px;bottom:8px;font-family:var(--pix);font-size:9px;color:var(--accent);animation:blink 1s steps(2) infinite}
.dlg .ch{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px}
.dlg .ch button{font-family:var(--pix);font-size:9px;background:var(--white);color:var(--navy);border:3px solid var(--navy);padding:9px 12px;cursor:pointer;box-shadow:3px 3px 0 var(--navy)}
.dlg .ch button.sel{background:var(--yellow)}
@keyframes blink{50%{opacity:0}}

/* Touch pad */
.touch{display:none;justify-content:space-between;align-items:center;margin-top:16px;gap:16px}
.touch.on{display:flex}
.dpad{display:grid;grid-template-columns:repeat(3,54px);grid-template-rows:repeat(3,54px);gap:4px}
.dpad button,.abtn{background:var(--navy);border:3px solid var(--white);color:var(--white);font-family:var(--pix);font-size:12px;touch-action:none;cursor:pointer;box-shadow:3px 3px 0 #0c0e22}
.dpad button:active,.abtn:active,.dpad button.held{background:var(--accent)}
.dpad .u{grid-area:1/2}.dpad .l{grid-area:2/1}.dpad .r{grid-area:2/3}.dpad .d{grid-area:3/2}
.abtn{width:84px;height:84px;border-radius:50%;background:var(--red);font-size:16px}
.help{font-family:var(--pix);font-size:8px;line-height:2;color:var(--soft);text-align:center;margin:18px 0 0;letter-spacing:.06em}
.help b{color:var(--yellow);font-weight:400}
.foot{font-family:var(--pix);font-size:7px;color:#6d7099;text-align:center;margin-top:10px;letter-spacing:.08em;line-height:2}

/* Overlay windows (guide style) */
.ov{position:fixed;inset:0;z-index:50;background:rgba(10,12,30,.74);display:flex;justify-content:center;align-items:flex-start;overflow-y:auto;padding-block:max(20px,env(safe-area-inset-top,0px)) 28px;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px))}
.ov.clear{background:linear-gradient(rgba(20,22,46,.25),rgba(20,22,46,.82))}
.win{width:100%;max-width:740px;background:var(--paper);color:var(--ink);border:3px solid var(--navy);box-shadow:8px 8px 0 rgba(0,0,0,.5);margin:auto 0}
.win.dark{background:var(--navy);color:var(--white)}
.bar{display:flex;align-items:center;justify-content:space-between;background:var(--accent);color:var(--white);font-family:var(--pix);font-size:9px;padding:8px 10px;letter-spacing:.08em;gap:8px;line-height:1.5}
.bar .ctl{letter-spacing:.4em;white-space:nowrap}
.win .in{padding:18px}
.pix{font-family:var(--pix);line-height:1.7}
.tag{display:inline-block;background:var(--navy);color:var(--yellow);font-family:var(--pix);font-size:9px;padding:6px 10px;letter-spacing:.1em;line-height:1.5}
.center{text-align:center}
.btn{font-family:var(--pix);font-size:10px;letter-spacing:.06em;background:var(--yellow);color:var(--navy);border:3px solid var(--navy);box-shadow:4px 4px 0 var(--navy);padding:12px 16px;cursor:pointer;line-height:1.4}
.btn:active{transform:translate(3px,3px);box-shadow:1px 1px 0 var(--navy)}
.btn.ghost{background:var(--white)}
.btn.go{background:var(--green);color:var(--white)}
.btn.warn{background:var(--red);color:var(--white)}
.btn[disabled]{opacity:.45;cursor:default}
.row{display:flex;gap:12px;flex-wrap:wrap;align-items:center}
.row.end{justify-content:flex-end}
.row.sb{justify-content:space-between}

/* Title */
.titlebox{width:100%;max-width:740px;margin:auto 0;text-align:center}
h1.logo{font-family:var(--pix);font-size:clamp(36px,10vw,76px);margin:6px 0 2px;color:var(--white);text-shadow:5px 5px 0 var(--navy),-3px -3px 0 var(--navy),3px -3px 0 var(--navy),-3px 3px 0 var(--navy),9px 9px 0 rgba(0,0,0,.35);letter-spacing:.06em;line-height:1.15}
.kicker{font-family:var(--pix);font-size:10px;letter-spacing:.14em;color:var(--white);text-shadow:2px 2px 0 var(--navy);line-height:1.8}
.ow{display:inline-block;font-family:var(--pix);font-size:10px;background:var(--red);color:var(--white);padding:7px 10px;border:3px solid var(--navy);transform:rotate(-3deg);margin-top:6px;letter-spacing:.1em}
.press{font-family:var(--pix);font-size:clamp(13px,3vw,18px);background:none;border:0;color:var(--white);text-shadow:3px 3px 0 var(--navy);cursor:pointer;display:block;margin:20px auto 6px;padding:12px}
.press .bl{animation:blink 1s steps(2) infinite}
.speech{background:var(--white);color:var(--ink);border:3px solid var(--navy);padding:12px 14px;font-size:15px;line-height:1.5;text-align:left;flex:1;min-width:0}
.speech b.who{display:block;font-family:var(--pix);font-size:8px;color:var(--muted);margin-bottom:6px;letter-spacing:.1em}
.hero{display:flex;gap:16px;align-items:center;margin:18px auto 0;max-width:600px}
.chips{display:flex;gap:8px;justify-content:center;flex-wrap:wrap;margin-top:14px}
.chips span{font-family:var(--pix);font-size:8px;background:var(--navy);color:var(--yellow);padding:7px 9px;border:2px solid var(--white)}
.nowplay{font-family:var(--pix);font-size:8px;color:var(--soft);margin-top:12px;line-height:1.8}

/* Player select */
.avatars{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin:14px 0}
.av{background:var(--white);border:3px solid var(--navy);box-shadow:4px 4px 0 var(--navy);padding:12px 6px 10px;cursor:pointer;display:flex;flex-direction:column;align-items:center;gap:8px;font-family:var(--pix);font-size:9px;color:var(--navy)}
.av canvas{width:64px;height:64px;image-rendering:pixelated}
.av[aria-pressed="true"]{background:var(--yellow);transform:translate(-2px,-2px);box-shadow:6px 6px 0 var(--navy)}
.namerow{display:flex;gap:10px;align-items:center;flex-wrap:wrap}
.namerow label{font-family:var(--pix);font-size:9px}
.namerow input{font-family:var(--pix);font-size:14px;border:3px solid var(--navy);padding:10px;width:220px;max-width:100%;background:var(--white);color:var(--ink);text-transform:uppercase}

/* Quiz */
.qmeta{display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap;font-family:var(--pix);font-size:8px;color:var(--muted);letter-spacing:.08em;margin-bottom:12px;line-height:1.6}
.qtext{font-size:clamp(17px,2.6vw,21px);font-weight:700;line-height:1.4;margin:0 0 16px;text-wrap:balance}
.opts{display:grid;gap:10px}
.opt{display:flex;gap:12px;align-items:flex-start;text-align:left;background:var(--white);border:3px solid var(--navy);padding:12px;font-family:var(--body);font-size:15px;line-height:1.4;color:var(--ink);cursor:pointer;box-shadow:3px 3px 0 var(--navy)}
.opt:hover:not([disabled]){background:var(--paper-2)}
.opt .k{font-family:var(--pix);font-size:9px;background:var(--navy);color:var(--yellow);padding:5px 6px;flex:0 0 auto;margin-top:1px}
.opt.right{background:#c9f2d6;border-color:#1f7a3f}
.opt.wrong{background:#ffd0d6;border-color:#a3182e}
.opt[disabled]{cursor:default}
.tf{grid-template-columns:1fr 1fr}
.tf .opt{justify-content:center;font-family:var(--pix);font-size:13px;padding:18px}
.bins{grid-template-columns:repeat(auto-fit,minmax(120px,1fr))}
.bins .opt{justify-content:center;align-items:center;font-family:var(--pix);font-size:9px;text-align:center;padding:16px 8px;line-height:1.5}
.bin-green{background:#c9f2d6!important}.bin-yellow{background:#fff0a8!important}.bin-red{background:#ffd0d6!important}
.sortcard{background:var(--white);border:3px solid var(--navy);box-shadow:4px 4px 0 var(--navy);padding:20px 16px;text-align:center;font-weight:700;font-size:18px;line-height:1.4;margin:4px auto 18px;max-width:480px}
.fb{margin-top:16px;border:3px solid var(--navy);background:var(--white);padding:14px;display:flex;gap:14px;align-items:flex-start}
.fb .msg{flex:1;min-width:0;font-size:15px;line-height:1.5}
.fb .verdict{font-family:var(--pix);font-size:10px;margin-bottom:8px;display:block;line-height:1.6}
.fb.ok .verdict{color:#1f7a3f}.fb.no .verdict{color:#a3182e}
.mission{background:var(--paper-2);border:3px dashed var(--navy);padding:10px 12px;font-size:14px;line-height:1.5;margin-bottom:14px}
.mission b.h{font-family:var(--pix);font-size:8px;letter-spacing:.08em;display:block;margin-bottom:6px}
.aiquote{background:var(--navy);color:var(--white);padding:10px 12px;font-size:13px;line-height:1.55;margin-top:8px}
.cards{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}
.card{background:var(--white);border:3px solid var(--navy);padding:10px;font-size:14px;line-height:1.35;text-align:left;cursor:pointer;font-family:var(--body);color:var(--ink);box-shadow:3px 3px 0 var(--navy);display:flex;gap:8px;align-items:center}
.card[disabled]{opacity:.35;cursor:default}
.card .k{font-family:var(--pix);font-size:9px;background:var(--navy);color:var(--yellow);padding:4px 6px}
.seq{display:flex;flex-wrap:wrap;gap:6px;min-height:44px;background:var(--navy);padding:8px;margin:12px 0}
.seq span{background:var(--yellow);color:var(--navy);font-size:12px;padding:6px 8px;font-weight:700}
.seq em{color:var(--soft);font-style:normal;font-family:var(--pix);font-size:8px;align-self:center}
.numrow{display:flex;gap:10px;flex-wrap:wrap;align-items:center}
.numrow input{font-family:var(--pix);font-size:16px;border:3px solid var(--navy);padding:10px;width:140px;background:var(--white);color:var(--ink)}
.numrow label{font-family:var(--pix);font-size:9px}
.boss{display:flex;gap:16px;align-items:center}
.hp{flex:1;min-width:0}
.hp .lbl{display:flex;justify-content:space-between;font-family:var(--pix);font-size:9px;margin-bottom:6px;color:var(--white);gap:8px}
.hpbar{height:16px;border:3px solid var(--white);padding:2px;background:#0c0e22}
.hpbar i{display:block;height:100%;background:var(--red);transition:width .35s steps(10)}
.shake{animation:shake .35s steps(4)}
@keyframes shake{25%{transform:translate(-5px,2px)}50%{transform:translate(5px,-2px)}75%{transform:translate(-3px,0)}}
.hit{animation:hit .4s steps(2)}
@keyframes hit{50%{filter:brightness(3) saturate(0)}}

/* Lists, log, map */
.keys{display:grid;gap:8px;margin:12px 0;padding:0;list-style:none}
.keys li{display:flex;gap:10px;font-size:15px;line-height:1.45}
.keys li b{font-family:var(--pix);font-size:9px;background:var(--navy);color:var(--yellow);padding:5px 6px;height:max-content;flex:0 0 auto}
.missed{display:grid;gap:8px;margin-top:10px}
.missed div{background:var(--white);border:2px solid var(--navy);padding:8px 10px;font-size:14px;line-height:1.4}
.missed code{font-family:var(--pix);font-size:8px;background:var(--navy);color:var(--yellow);padding:3px 5px;margin-right:6px}
.big{font-family:var(--pix);font-size:clamp(18px,5vw,28px);line-height:1.5;margin:10px 0;text-align:center}
.small{font-size:13px;color:var(--muted);line-height:1.5}
.stars{letter-spacing:.15em;font-family:var(--pix)}
.stars .off{opacity:.25}
.log{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:12px}
.logw{border:3px solid var(--navy);background:var(--white);padding:12px}
.logw h3{font-family:var(--pix);font-size:10px;margin:0 0 4px;line-height:1.6;font-weight:400}
.logw p{margin:0 0 8px;font-size:13px;color:var(--muted)}
.logw ul{list-style:none;margin:0;padding:0;display:grid;gap:5px}
.logw li{display:flex;justify-content:space-between;gap:8px;font-size:13px;line-height:1.35}
.logw li .s{font-family:var(--pix);font-size:8px;white-space:nowrap}
.done{color:#1f7a3f}.todo{color:var(--muted)}
.mapwrap{background:var(--navy);padding:10px;border:3px solid var(--navy);overflow-x:auto}
#mm{width:100%;max-width:640px;display:block;margin:0 auto;image-rendering:pixelated}
.warps{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:10px;margin-top:14px}
.warp{display:flex;align-items:center;gap:10px;text-align:left;background:var(--white);border:3px solid var(--navy);box-shadow:3px 3px 0 var(--navy);padding:10px;cursor:pointer;font-family:var(--body);color:var(--ink)}
.warp .sw{width:16px;height:16px;border:2px solid var(--navy);flex:0 0 auto}
.warp b{display:block;font-family:var(--pix);font-size:8px;line-height:1.6;font-weight:400}
.warp span{font-size:12px;color:var(--muted)}
.menu{display:grid;gap:10px;max-width:420px;margin:0 auto}
.menu .btn{width:100%;text-align:left}
details.oe{background:var(--white);border:3px solid var(--navy);padding:12px;margin-top:12px}
details.oe summary{cursor:pointer;font-family:var(--pix);font-size:9px;color:var(--accent);margin-top:10px;line-height:1.6}
details.oe p{font-size:14px;line-height:1.55;margin:10px 0 0}
.oe .q{font-weight:700;font-size:15px;line-height:1.45}
.cert{border:6px double var(--navy);background:var(--paper);padding:26px 18px;text-align:center;color:var(--ink)}
.cert .cn{font-family:var(--pix);font-size:clamp(18px,5vw,30px);color:var(--accent);margin:14px 0;line-height:1.4;word-break:break-word}
.cert p{line-height:1.6;max-width:520px;margin:8px auto}
svg.spr{image-rendering:pixelated;shape-rendering:crispEdges;display:block}
.bob{animation:bob 1.2s steps(2) infinite}
@keyframes bob{50%{transform:translateY(-4px)}}
@media (max-width:620px){
  .avatars{grid-template-columns:repeat(2,1fr)}
  .cards{grid-template-columns:1fr}
  .hero{flex-direction:column}
  .where{order:5;flex-basis:100%;text-align:left}
  .dlg{padding:16px 12px 10px}
}
@media (pointer:coarse){.touch{display:flex}}
@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
</style>

<div class="shell">
  <header class="hud">
    <div class="hearts" id="hHearts" aria-label="Hearts"></div>
    <div class="where" id="hWhere">AI QUEST</div>
    <div class="cores" id="hCores" aria-label="Memory cores"></div>
    <div class="hbtns">
      <button class="iconbtn" id="bMap" title="World map (M)">MAP</button>
      <button class="iconbtn" id="bMenu" title="Menu (Esc)">MENU</button>
      <button class="iconbtn" id="bMus" aria-pressed="true" title="Music on/off">♪ ON</button>
    </div>
  </header>
  <div class="stage" id="stage">
    <canvas id="cv" width="320" height="192" aria-label="AI QUEST overworld"></canvas>
    <div class="banner" id="banner" hidden></div>
    <div class="toast" id="toast" hidden></div>
    <button class="prompt" id="prompt" hidden></button>
    <div class="dlg" id="dlg" hidden><span class="nm" id="dlgN"></span><div class="tx" id="dlgT"></div><div class="ch" id="dlgC"></div><span class="more" id="dlgM">▼</span></div>
  </div>
  <div class="touch" id="touch">
    <div class="dpad" aria-label="Move">
      <button class="u" data-d="u" aria-label="Up">▲</button><button class="l" data-d="l" aria-label="Left">◀</button>
      <button class="r" data-d="r" aria-label="Right">▶</button><button class="d" data-d="d" aria-label="Down">▼</button>
    </div>
    <button class="abtn" id="aBtn" aria-label="Talk / OK">A</button>
  </div>
  <p class="help"><b>ARROWS / WASD</b> WALK · <b>E / SPACE</b> TALK · <b>M</b> MAP · <b>ESC</b> MENU</p>
  <p class="foot">TEAM SLN · AI OVERVIEW MODULE · CONTENT FROM STUDY GUIDE V1.0 &amp; TEST BANK V1.0 · ORIGINAL CHIPTUNE THEME</p>
</div>
<div class="ov" id="ov" hidden></div>

<script>
"use strict";
const $=id=>document.getElementById(id);
const esc=s=>String(s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const shuffle=a=>{a=a.slice();for(let i=a.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[a[i],a[j]]=[a[j],a[i]]}return a};
