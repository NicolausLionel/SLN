 // Ethics Castle carpet
 fillR(31,5,32,11,T.CARPET);
 // App City streets and blocks
 fillR(41,32,59,33,T.ROADH);fillR(42,39,59,39,T.ROADH);fillR(50,30,51,43,T.ROADV);
 for(const y of [32,33,39])for(const x of [50,51])setT(x,y,T.ROADX);
 [[43,30],[44,30],[54,30],[55,30],[58,30],[43,35],[44,35],[43,36],[44,36],[57,35],[58,35],[57,36],[58,36],[43,42],[44,42],[57,42],[58,42]].forEach(([x,y])=>setT(x,y,T.BLDG));
 // Fortress pillars
 [[29,38],[34,38],[29,42],[34,42]].forEach(([x,y])=>setT(x,y,T.FWALL));
 // Plaza and roads
 fillR(PLAZA.x0,PLAZA.y0,PLAZA.x1,PLAZA.y1,T.PLAZA);
 fillR(23,13,40,14,T.PATH);fillR(31,12,32,18,T.PATH);fillR(23,32,40,33,T.PATH);fillR(31,29,32,35,T.PATH);
 // Reserve cells around everything you interact with
 const res=new Set();const reserve=(x,y,rad=1)=>{for(let dy=-rad;dy<=rad;dy++)for(let dx=-rad;dx<=rad;dx++)res.add((x+dx)+','+(y+dy))};
 STATIONS.forEach(s=>reserve(s.x,s.y));Object.values(SHRINES).forEach(([x,y])=>reserve(x,y));Object.values(SIGNS).forEach(([x,y])=>reserve(x,y));
 for(const k in ZONES)ZONES[k].ent.forEach(([x,y])=>reserve(x,y,2));
 Object.values(WARP).forEach(([x,y])=>reserve(x,y));
 const freeAround=(x,y)=>{for(let dy=-1;dy<=1;dy++)for(let dx=-1;dx<=1;dx++){const t=at(x+dx,y+dy);if(SOLID.has(t)||t===T.PATH||t===T.BRIDGE||t===T.PLAZA||t===T.ROADH||t===T.ROADV||t===T.ROADX)return false}return true};
 const place=(x,y,t)=>{if(res.has(x+','+y)||!freeAround(x,y))return false;setT(x,y,t);return true};
 for(const k of [1,2,4]){const z=ZONES[k];for(let y=z.y0+1;y<z.y1;y++)for(let x=z.x0+1;x<z.x1;x++)if(r()<.16)place(x,y,z.deco)}
 // Overworld meadow: trees and bushes outside zones and plaza
 for(let y=3;y<MH-3;y++)for(let x=3;x<MW-3;x++){
  let inZ=false;for(const k in ZONES)if(inR(x,y,{x0:ZONES[k].x0-1,y0:ZONES[k].y0-1,x1:ZONES[k].x1+1,y1:ZONES[k].y1+1}))inZ=true;
  if(inZ||inR(x,y,{x0:PLAZA.x0-1,y0:PLAZA.y0-1,x1:PLAZA.x1+1,y1:PLAZA.y1+1}))continue;
  const t=at(x,y);if((t===T.GRASS||t===T.FLOW)&&r()<.1)place(x,y,r()<.6?T.TREE:T.BUSH)}
 // Glitch overlay cells (scrambled memory) per world
 for(const k of [1,2,3,4,5]){const z=ZONES[k];let n=0,guard=0;while(n<12&&guard++<500){const x=z.x0+1+Math.floor(r()*(z.x1-z.x0-1)),y=z.y0+1+Math.floor(r()*(z.y1-z.y0-1));
  if(!SOLID.has(at(x,y))&&!res.has(x+','+y)){GLITCH[k].push([x,y]);n++}}}
}

