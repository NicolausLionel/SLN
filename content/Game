function openOv(html,{closable=true,clear=false}={}){const o=$('ov');o.innerHTML=html;o.hidden=false;o.classList.toggle('clear',clear);ovClosable=closable;clearKeys();o.scrollTop=0;Music.duck(S.mode==='play');$('prompt').hidden=true}
function closeOv(){$('ov').hidden=true;$('ov').innerHTML='';ENC=null;Music.duck(false);if(S.mode==='play')Music.play(regionSong());cv.focus&&cv.focus()}
$('ov').addEventListener('click',e=>{if(e.target.id==='ov'&&ovClosable&&!ENC)closeOv()});
const win=(title,inner,accent,cls='')=>`<section class="win ${cls}"><div class="bar" style="${accent?`background:${accent}`:''}"><span>${title}</span><span class="ctl">_ □ ×</span></div><div class="in">${inner}</div></section>`;
const starStr=n=>`<span class="stars">${[1,2,3].map(i=>`<span class="${i<=n?'':'off'}">★</span>`).join('')}</span>`;
const regionSong=()=>S.region===6?'boss':'main';

/* ---------- Title / select / intro ---------- */
function titleScreen(){S.mode='title';S.region=null;document.body.style.setProperty('--accent','#ef6a3a');$('hWhere').textContent='AI QUEST · OPEN WORLD';
 const has=SAVE.started;
 openOv(`<div class="titlebox">
  <p class="kicker">— MODULE: AI OVERVIEW · TEAM SLN —</p>
  <h1 class="logo">AI QUEST</h1>
  <span class="ow">OPEN WORLD EDITION</span>
  <div class="hero"><div class="bob">${svgSpr('byte',8)}</div>
   <div class="speech"><b class="who">BYTE:</b>Beep… my memory chips got scrambled into five worlds! Walk the island, talk to everyone, clear the tasks and restore my five Memory Cores.</div></div>
  <div class="chips"><span>5 WORLDS</span><span>23 TASKS</span><span>40-QUESTION BOSS</span><span>ORIGINAL THEME SONG</span></div>
  ${has?`<div class="row" style="justify-content:center;margin-top:22px"><button class="btn go" id="tCont">▸ CONTINUE (${esc(SAVE.name)} · ${coreCount()}/5 CORES)</button><button class="btn ghost" id="tNew">NEW GAME</button></div>`
       :`<button class="press" id="tStart">▸ PRESS <span class="bl">START</span> ◂</button>`}
  <p class="nowplay">♪ THE AI QUEST THEME STARTS WHEN YOU PRESS START</p></div>`,{closable:false,clear:true});
 const go=fn=>()=>{Music.init();Music.play('main');SFX.click();fn()};
 if(has){$('tCont').onclick=go(()=>startPlay(false));$('tNew').onclick=go(()=>playerSelect(true))}else $('tStart').onclick=go(()=>playerSelect(true))}

function playerSelect(reset){let pick=SAVE.avatar||'maya';
 openOv(win('PLAYER SELECT',`
  <p style="margin-top:0;line-height:1.55">Choose your hero. BYTE will follow you everywhere.</p>
  <div class="avatars">${AVATARS.map(a=>`<button class="av" data-a="${a.id}" aria-pressed="${a.id===pick}"><canvas width="16" height="16" data-p="${a.id}"></canvas>${a.name}<span style="font-family:var(--body);font-size:11px;line-height:1.3;text-align:center;color:var(--muted)">${a.bio}</span></button>`).join('')}</div>
  <div class="namerow"><label for="pname">PLAYER NAME</label><input id="pname" maxlength="12" autocomplete="off" value="${esc(AVATARS.find(a=>a.id===pick).name)}"></div>
  <div class="row end" style="margin-top:16px"><button class="btn ghost" id="psBack">◂ BACK</button><button class="btn go" id="psGo">BEGIN QUEST ▸</button></div>`),{closable:false,clear:true});
 const draw=()=>document.querySelectorAll('canvas[data-p]').forEach(c=>{const g=c.getContext('2d');g.clearRect(0,0,16,16);g.drawImage(AVSPR[c.dataset.p].down[Math.floor(performance.now()/300)%2],0,0)});
 draw();const iv=setInterval(()=>{if(!document.querySelector('canvas[data-p]'))return clearInterval(iv);draw()},300);
 document.querySelectorAll('.av').forEach(b=>b.onclick=()=>{SFX.click();const old=AVATARS.find(a=>a.id===pick).name;pick=b.dataset.a;
  document.querySelectorAll('.av').forEach(x=>x.setAttribute('aria-pressed',x.dataset.a===pick));const inp=$('pname');if(!inp.value.trim()||inp.value.toUpperCase()===old)inp.value=AVATARS.find(a=>a.id===pick).name});
 $('psBack').onclick=()=>titleScreen();
 $('psGo').onclick=()=>{const name=($('pname').value.trim()||'PLAYER').toUpperCase().slice(0,12);
  if(reset){const keep={music:SAVE.music,sfx:SAVE.sfx};SAVE=Object.assign(fresh(),keep)}
  SAVE.name=name;SAVE.avatar=pick;SAVE.started=true;S.hearts=5;S.px=WARP[0][0]*TS+8;S.py=WARP[0][1]*TS;S.trail=[];persist();startPlay(true)}}

function startPlay(intro){closeOv();S.mode='play';if(SAVE.pos&&!intro){S.px=SAVE.pos[0];S.py=SAVE.pos[1]}S.hearts=clamp(SAVE.hearts||5,1,5);S.trail=[];S.region=null;hud();
 if(blocked(S.px,S.py)){S.px=WARP[0][0]*TS+8;S.py=WARP[0][1]*TS}
 if(intro)setTimeout(()=>say('BYTE',[
  `Beep… hello, ${SAVE.name}! I'm BYTE, a helper robot from the SLN Computing Lab.`,
  "A power surge scrambled my knowledge into five Memory Cores, hidden in five worlds around this plaza.",
  "Visit the worlds in any order you like. Talk to the terminals, quiz bots, guardians and mission boards to clear their tasks.",
  "Clear every task in a world and its Memory Core shrine lights up. Restore all five cores to open the Glitch Fortress in the south.",
  "Walk with the arrow keys or WASD, talk with E or Space, press M for the map and Esc for the menu. On a phone, use the buttons below the screen.",
  "The fountain is a save point: it refills your hearts. One more thing… I talk confidently, but sometimes I'm wrong. Let's learn when AI can be trusted!"],[{label:'LET\'S GO!'}],'#5b3fd0'),350)}

/* ================= WORLD INTERACTIONS ================= */
const KIND_NAME={terminal:'TERMINAL',bot:'QUIZ BOT',guard:'GUARDIAN',board:'MISSION BOARD',tablet:'TIMELINE TABLET',stand:'FRUIT STAND',desk:'REDACTION DESK',traffic:'TRAFFIC LIGHT'};
function promptText(e){const v=matchMedia('(pointer:coarse)').matches?'A':'E';
 const lbl=e.kind==='station'?e.st.name:e.kind==='shrine'?`MEMORY CORE SHRINE ${e.wn}`:e.kind==='sign'?(e.wn===6?'FORTRESS SIGN':`WORLD ${e.wn} SIGN`):e.kind==='fountain'?'SAVE FOUNTAIN':e.kind==='qboard'?'QUEST BOARD':e.kind==='library'?'SCROLL LIBRARY':e.kind==='boss'?'MISINFORMATION MONSTER':'FORTRESS GATE';
 return `<b>${v}</b> · ${esc(lbl)}`}
function interact(e){if(!e)return;SFX.talk();
 switch(e.kind){
  case 'station':return stationTalk(e.st);
  case 'shrine':return shrineTalk(e.wn);
  case 'sign':return signTalk(e.wn);
  case 'fountain':S.hearts=5;hud();persist();SFX.heal();return say('SAVE FOUNTAIN',['The water sparkles. Hearts restored and game saved.'],null,'#5fb0d8');
  case 'qboard':return questLog();
  case 'library':return say('SCROLL LIBRARY',['Part C of the test bank: 6 open-ended questions.','Write your own answer first (normally more than 100 words), then open a scroll to compare it with the key points.'],[{label:'READ SCROLLS',fn:partC},{label:'LATER'}],'#7a4a22');
  case 'boss':return bossTalk();
  case 'gate':return gateOpen()?null:say('FORTRESS GATE',['The gate is sealed by glitch energy.',`It opens when all five Memory Cores are restored. You have ${coreCount()} of 5.`,'(Practising for the exam? Boss practice is in the MENU.)'],null,FORTRESS.accent);
 }}
function stationTalk(st){const W=WORLDS[st.w],acc=W.accent,qs=st.qs(),n=qs.length,best=SAVE.stations[st.id];
 let lines;
 if(st.kind==='terminal')lines=[`BOOTING TEST BANK… WORLD ${st.w}: ${W.topic.toUpperCase()}.`,`Part A: ${n} true/false statements from Team SLN's test bank. Each wrong answer costs one heart.`];
 else if(st.kind==='bot')lines=[`Beep! I'm the Quiz Bot of ${W.name}.`,`Part B: ${n} multiple-choice questions. Pick the ONE best answer.`];
 else if(st.kind==='guard')lines=[`Halt, ${SAVE.name}! Nobody passes the World ${st.w} save point without the checkpoint.`,`${n} questions. Score below 4 and the guide says: replay the stages you missed!`];
 else lines=[st.name,st.brief];
 if(best)lines=[...lines.slice(0,1),`Task cleared ${'★'.repeat(best)}${'☆'.repeat(3-best)}. Replay for practice? Your best stars are kept.`];
 say(st.kind==='station'?KIND_NAME[st.kind]:KIND_NAME[st.kind],lines,[{label:best?'REPLAY':'START',fn:()=>runEncounter({mode:'station',st,qs:st.keep?qs.slice():shuffle(qs),title:st.name,accent:acc,brief:st.brief||null})},{label:'LATER'}],acc)}
function shrineTalk(w){const W=WORLDS[w],done=zoneDone(w),tot=zoneStations(w).length;
 if(SAVE.cores[w])return say(`CORE SHRINE ${w}`,[`Memory Core ${w} is restored ${'★'.repeat(SAVE.cores[w])}. ${W.core}`],[{label:'KEY IDEAS',fn:()=>coreScreen(w,false)},{label:'CLOSE'}],W.accent);
 if(done<tot){const left=zoneStations(w).filter(s=>!SAVE.stations[s.id]).map(s=>s.name.replace(/^MISSION [\d.]+ · /,'')).join(', ');
  return say(`CORE SHRINE ${w}`,['A dim Memory Core shrine. It flickers with scrambled memories.',`Clear ${tot-done} more task${tot-done>1?'s':''} in ${W.name} to power it: ${left}.`],null,W.accent)}
 say(`CORE SHRINE ${w}`,['The shrine hums with light… every task in this world is clear!'],[{label:'RESTORE CORE',fn:()=>restoreCore(w)}],W.accent)}
function signTalk(w){if(w===6)return say('SIGNPOST',['▼ GLITCH FORTRESS','Lair of the Misinformation Monster. The gate opens when all five Memory Cores are restored.'],null,FORTRESS.accent);
 const W=WORLDS[w];say('SIGNPOST',[`WORLD ${w} · ${W.name} — ${W.topic}`,W.story,`Tasks cleared here: ${zoneDone(w)} of ${zoneStations(w).length}.`],null,W.accent)}
function bossTalk(){const acc=FORTRESS.accent;
 if(SAVE.bossBeaten)return say('MISINFORMATION MONSTER',['…bzzt. You defeated me. But misinformation always comes back.','Fight again for practice?'],[{label:'FIGHT',fn:startBoss},{label:'CERTIFICATE',fn:certificate},{label:'LATER'}],acc);
 say('MISINFORMATION MONSTER',['ZZT… I AM THE MISINFORMATION MONSTER!','Confident words, fake sources, fluent nonsense — that is my power!','Face all 40 questions of the test bank. Every correct answer deals 1 damage. 32 or more defeats me.'],[{label:'FIGHT!',fn:startBoss},{label:'RETREAT'}],acc)}
function startBoss(){Music.play('boss');runEncounter({mode:'boss',qs:shuffle(BANK),title:'FINAL BOSS',accent:FORTRESS.accent})}

/* ================= ENCOUNTER (QUIZ) ================= */
function runEncounter(o){ENC={...o,i:0,correct:0,missed:[],answered:false,active:true};openOv('',{closable:false});if(o.mode==='boss')Music.duck(false);ask()}
function ask(){const r=ENC,q=r.qs[r.i];r.answered=false;
 const label=r.mode==='boss'?(q.type==='tf'?'PART A · TRUE / FALSE':'PART B · MULTIPLE CHOICE'):(q.type==='sort'||q.type==='order'?'MISSION':q.cp||q.type==='num'?'CHECKPOINT':q.type==='tf'?'TRUE / FALSE':'MULTIPLE CHOICE');
 let body='';
 if(r.brief&&r.mode!=='boss')body+=`<div class="mission"><b class="h">${esc(r.title)}</b>${esc(r.brief)}${q.ctx?`<div class="aiquote">${esc(q.ctx)}</div>`:''}</div>`;
 if(q.type==='tf')body+=`<p class="qtext">${esc(q.q)}</p><div class="opts tf"><button class="opt" data-v="1">TRUE</button><button class="opt" data-v="0">FALSE</button></div>`;
 else if(q.type==='mc'){r.order=shuffle(q.opts.map((_,i)=>i));body+=`<p class="qtext">${esc(q.q)}</p><div class="opts">${r.order.map((oi,k)=>`<button class="opt" data-v="${oi}"><span class="k">${'ABCD'[k]}</span><span>${esc(q.opts[oi])}</span></button>`).join('')}</div>`}
 else if(q.type==='sort'){const light=q.bins===B_LIGHT;body+=`<div class="sortcard">${esc(q.q)}</div><div class="opts bins">${q.bins.map((b,i)=>`<button class="opt ${light?['bin-green','bin-yellow','bin-red'][i]:''}" data-v="${i}"><span class="k">${i+1}</span>${b}</button>`).join('')}</div>`}
 else if(q.type==='order'){r.seq=[];body+=`<p class="qtext">${esc(q.q)}</p><div class="cards">${shuffle(q.items).map(([k,t])=>`<button class="card" data-k="${k}"><span class="k">${k}</span><span>${esc(t)}</span></button>`).join('')}</div>
   <div class="seq" id="seq"><em>YOUR ORDER APPEARS HERE</em></div><div class="row end"><button class="btn ghost" id="undo">UNDO</button><button class="btn go" id="check" disabled>CHECK ORDER</button></div>`}
 else if(q.type==='num')body+=`<p class="qtext">${esc(q.q)}</p><form class="numrow" id="numf"><label for="numin">ANSWER (${q.unit})</label><input id="numin" inputmode="decimal" autocomplete="off" required><button class="btn go" type="submit">SUBMIT</button></form>`;
 const head=r.mode==='boss'?bossHead():'';
 const heartsRow=r.mode==='station'?`<span>${'♥'.repeat(S.hearts)}${'♡'.repeat(5-S.hearts)}</span>`:'';
 $('ov').innerHTML=`<div style="width:100%;max-width:740px;margin:auto 0">${head}${win(`${label} · ${r.i+1} / ${r.qs.length}`,`<div class="qmeta"><span>${esc(q.id)} · WORLD ${q.w}</span>${heartsRow?`<span style="color:var(--red);font-size:11px">${heartsRow}</span>`:`<span>${esc(WORLDS[q.w].topic.toUpperCase())}</span>`}</div>${body}<div id="fbx"></div>
  <div class="row sb" id="encFoot" style="margin-top:14px"><button class="btn ghost" id="retreat">◂ LEAVE</button><span class="small">Keys: 1–4 / A–D · T / F · Enter</span></div>`,r.accent)}</div>`;
 $('ov').scrollTop=0;
 $('retreat').onclick=()=>{ENC=null;closeOv();toast(r.mode==='boss'?'You retreated. The monster waits…':'Task left unfinished. Come back any time.')};
 $('ov').querySelectorAll('.opts .opt').forEach(b=>b.onclick=()=>answer(b));
 if(q.type==='order'){const seqEl=$('seq'),chk=$('check');
  const paint=()=>{seqEl.innerHTML=r.seq.length?r.seq.map(k=>`<span>${k}</span>`).join(''):'<em>YOUR ORDER APPEARS HERE</em>';chk.disabled=r.seq.length!==q.items.length;
   $('ov').querySelectorAll('.card').forEach(c=>c.disabled=r.seq.includes(c.dataset.k)||r.answered)};
  $('ov').querySelectorAll('.card').forEach(c=>c.onclick=()=>{if(r.answered)return;SFX.click();r.seq.push(c.dataset.k);paint()});
  $('undo').onclick=()=>{if(r.answered)return;r.seq.pop();paint()};
  chk.onclick=()=>{if(r.answered)return;const right=r.seq.filter((k,i)=>k===q.a[i]).length,ok=right===q.a.length;
   seqEl.innerHTML=r.seq.map((k,i)=>`<span style="background:${k===q.a[i]?'#c9f2d6':'#ffd0d6'}">${k}</span>`).join('');
   $('undo').disabled=true;chk.disabled=true;resolve(ok,esc(`${right} / 8 in the right place. ${q.ex}`))}}
 if(q.type==='num'){const f=$('numf');setTimeout(()=>{const i=$('numin');if(i)i.focus()},50);f.onsubmit=e=>{e.preventDefault();if(r.answered)return;
  const v=parseFloat($('numin').value.replace(/[^0-9.\-]/g,''));const ok=q.a.includes(v);f.querySelectorAll('input,button').forEach(x=>x.disabled=true);resolve(ok,esc(q.ex))}}}
function answer(btn){const r=ENC,q=r.qs[r.i];if(!r||r.answered)return;const v=+btn.dataset.v;let ok,correct;
 if(q.type==='tf'){ok=(v===1)===q.a;correct=[q.a?1:0]}else if(q.type==='mc'){ok=v===q.a;correct=[q.a]}else{ok=q.a.includes(v);correct=q.a}
 $('ov').querySelectorAll('.opts .opt').forEach(b=>{b.disabled=true;if(correct.includes(+b.dataset.v))b.classList.add('right')});
 if(!ok)btn.classList.add('wrong');
 let ex=esc(q.ex);if(q.type==='tf')ex=`<b>${q.a?'TRUE':'FALSE'}.</b> ${q.a?'':'<b>Correction:</b> '}${ex}`;
 resolve(ok,ex)}
function resolve(ok,exHtml){const r=ENC,q=r.qs[r.i];r.answered=true;
 if(ok){r.correct++;SFX.ok()}else{r.missed.push(q);SFX.no();if(r.mode==='station'){S.hearts=Math.max(0,S.hearts-1);hud()}}
 const last=r.i===r.qs.length-1,dead=r.mode==='station'&&S.hearts<=0;
 const lines=ok?['Memory chip repaired!','Beep boop — correct!','Byte-sized win!','XP up!']:['Ouch… glitch detected.','Error! Let\'s learn from it.','My circuits disagree…'];
 const bl=r.mode==='boss'?(ok?' The monster takes 1 damage!':' The monster strikes!'):(!ok?' −1 ♥':'');
 $('fbx').innerHTML=`<div class="fb ${ok?'ok':'no'}"><div>${svgSpr(ok?'byte':'byteSad',4)}</div><div class="msg"><span class="verdict">${ok?'✓ CORRECT':'✗ NOT QUITE'} — ${lines[Math.floor(Math.random()*lines.length)]}${bl}</span>${exHtml}</div></div>`;
 $('encFoot').innerHTML=`<button class="btn ghost" id="retreat">◂ LEAVE</button><button class="btn" id="next">${dead?'OUT OF HEARTS ▸':last?'FINISH ▸':'NEXT ▸'}</button>`;
 $('retreat').onclick=()=>{ENC=null;closeOv()};
 if(r.mode==='boss')updBoss(ok);else if(!ok){const w=$('ov').querySelector('.win');w.classList.remove('shake');void w.offsetWidth;w.classList.add('shake')}
 const nx=$('next');nx.focus({preventScroll:true});
 nx.onclick=()=>{if(dead)return knockedOut();if(last)return r.mode==='boss'?bossEnd():stationEnd();r.i++;ask()};
 setTimeout(()=>{const f=$('fbx');if(f&&f.scrollIntoView)f.scrollIntoView({block:'nearest',behavior:'smooth'})},30)}
function stationEnd(){const r=ENC,st=r.st,miss=r.missed.length,stars=miss===0?3:miss===1?2:1;const firstClear=!SAVE.stations[st.id];
 SAVE.stations[st.id]=Math.max(SAVE.stations[st.id]||0,stars);S.hearts=Math.min(5,S.hearts+1);persist();hud();SFX.heal();
 const w=st.w,ready=zoneDone(w)===zoneStations(w).length&&!SAVE.cores[w];ENC.active=false;
 openOv(win('TASK CLEAR',`<p class="big">${esc(st.name.replace(/^MISSION [\d.]+ · /,''))}<br>CLEARED!</p>
  <p class="center pix" style="font-size:12px">${r.correct} / ${r.qs.length} CORRECT · ${starStr(stars)}</p>
  <p class="center small">+1 ♥ for clearing a task.${firstClear?'':' Best stars kept.'}</p>
  ${ready?`<div class="mission"><b class="h">THE SHRINE AWAKENS</b>Every task in ${WORLDS[w].name} is clear. Walk to the Memory Core shrine to restore Core ${w}!</div>`:`<p class="center small">${WORLDS[w].name}: ${zoneDone(w)} / ${zoneStations(w).length} tasks cleared.</p>`}
  ${miss?`<p class="pix" style="font-size:9px">REVIEW THESE (${miss})</p><div class="missed">${r.missed.map(q=>`<div><code>${esc(q.id)}</code>${esc(q.q)}</div>`).join('')}</div>`:''}
  <div class="row end" style="margin-top:16px"><button class="btn go" id="back">BACK TO THE WORLD ▸</button></div>`,r.accent),{closable:true});
 ENC=null;$('back').onclick=()=>{closeOv();if(ready)toast(`Core Shrine ${w} is glowing!`)};$('back').focus()}
function knockedOut(){ENC=null;SFX.lose();
 openOv(win('OUT OF HEARTS',`<div class="center">${svgSpr('byteSad',8)}</div><p class="big">BYTE RAN OUT<br>OF POWER</p>
  <p class="center" style="line-height:1.55">You wake up at the plaza fountain with full hearts. The task resets, so try it again when you're ready.</p>
  <div class="row end" style="margin-top:16px"><button class="btn go" id="respawn">RESPAWN ▸</button></div>`,'#a3182e'),{closable:false});
 $('respawn').onclick=()=>{S.hearts=5;warpTo(0,true);closeOv();hud();persist()};$('respawn').focus()}
function restoreCore(w){const ss=zoneStations(w).map(s=>SAVE.stations[s.id]||1);const stars=Math.floor(ss.reduce((a,b)=>a+b,0)/ss.length);
 SAVE.cores[w]=stars;S.hearts=5;persist();hud();Music.jingle();coreScreen(w,true)}
function coreScreen(w,fresh){const W=WORLDS[w];
 openOv(win(fresh?'SAVE POINT · MEMORY CORE':'MEMORY CORE '+w,`<div class="center">${svgSpr('core',10,'bob')}</div>
  <p class="big">MEMORY CORE ${w}<br>RESTORED!</p><p class="center" style="font-size:16px;line-height:1.5;margin:0 0 6px">${W.core}</p>
  <p class="center pix" style="font-size:12px">${starStr(SAVE.cores[w])} · CORES ${coreCount()} / 5</p>
  <div class="mission"><b class="h">KEY IDEAS TO KEEP · ${W.topic.toUpperCase()}</b><ul class="keys">${W.keys.map((k,i)=>`<li><b>${w}.${i+1}</b><span>${k}</span></li>`).join('')}</ul></div>
  ${fresh&&coreCount()===5?`<div class="mission"><b class="h">ALL FIVE CORES!</b>The Glitch Fortress gate in the south has opened. The Misinformation Monster awaits.</div>`:''}
  <div class="row end"><button class="btn go" id="back">CONTINUE ▸</button></div>`,W.accent));
 $('back').onclick=()=>{closeOv();if(fresh&&coreCount()===5)toast('The Fortress gate is open!')}}

function bossHead(){const hp=40-ENC.correct;return `<section class="win dark" id="bossbox" style="margin-bottom:14px"><div class="in boss"><div id="bspr">${svgSpr('boss',6)}</div><div class="hp"><div class="lbl"><span>MISINFORMATION MONSTER</span><span id="hpn">${hp}/40</span></div><div class="hpbar"><i id="hpb" style="width:${hp/40*100}%"></i></div></div></div></section>`}
function updBoss(ok){const hp=40-ENC.correct;$('hpn').textContent=hp+'/40';$('hpb').style.width=(hp/40*100)+'%';const el=$(ok?'bspr':'bossbox');el.classList.remove('hit','shake');void el.offsetWidth;el.classList.add(ok?'hit':'shake')}
function bossEnd(){const r=ENC,s=r.correct;ENC=null;const firstWin=s>=32&&!SAVE.bossBeaten;SAVE.boss=Math.max(SAVE.boss||0,s);if(s>=32)SAVE.bossBeaten=true;persist();
 const band=s>=32?['BOSS DEFEATED!','The Misinformation Monster dissolves into static. BYTE is fully restored.']:s>=24?['ONE MORE TRY','So close! Replay the worlds tagged below, then come back.']:['RESPAWN','Replay the worlds tagged on the questions you missed, then try again.'];
 s>=32?Music.jingle():SFX.lose();
 const byW={};r.missed.forEach(q=>(byW[q.w]=byW[q.w]||[]).push(q));
 openOv(win('BOSS FIGHT · RESULTS',`<div class="center">${s>=32?svgSpr('byte',9,'bob'):svgSpr('boss',7,'bob')}</div>
