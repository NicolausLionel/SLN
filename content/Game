function update(dt){S.t+=dt;
 if(S.dlg){const d=S.dlg,line=d.lines[d.i];if(d.shown<line.length){const before=Math.floor(d.shown);d.shown=Math.min(line.length,d.shown+dt*55);if(Math.floor(d.shown)!==before){$('dlgT').textContent=line.slice(0,Math.floor(d.shown));if(d.shown>=line.length)renderDlg(true)}}}
 if(S.mode!=='play'){const mx=MW*TS-S.vw,my=MH*TS-S.vh;S.cam.x=Math.round(mx/2+Math.sin(S.t*.07)*mx*.45);S.cam.y=Math.round(my/2+Math.cos(S.t*.05)*my*.4);return}
 const paused=overlayOpen()||S.dlg;
 let dx=(keys.r?1:0)-(keys.l?1:0),dy=(keys.d?1:0)-(keys.u?1:0);
 if(paused){dx=0;dy=0}
 S.moving=!!(dx||dy);
 if(S.moving){const len=Math.hypot(dx,dy),sp=78*dt;const mx=dx/len*sp,my=dy/len*sp;
  if(!blocked(S.px+mx,S.py))S.px+=mx;if(!blocked(S.px,S.py+my))S.py+=my;
  S.dir=Math.abs(dx)>Math.abs(dy)?(dx>0?'right':'left'):(dy>0?'down':'up');S.anim+=dt;
  S.trail.push({x:S.px,y:S.py});if(S.trail.length>60)S.trail.shift()}
 // region
 const tx=Math.floor((S.px+8)/TS),ty=Math.floor((S.py+12)/TS),reg=regionOf(tx,ty);
 if(reg!==S.region){const prev=S.region;S.region=reg;$('hWhere').textContent=regionName(reg);document.body.style.setProperty('--accent',regionAccent(reg));
  if(reg!==0)banner(reg);else $('banner').hidden=true;Music.play(regionSong())}
 // nearest interactable
 let best=null,bd=1e9;const cx=S.px+8,cy=S.py+12;
 if(!paused)for(const e of ENTS){if(e.kind==='gate'&&gateOpen())continue;const ex0=e.x*TS-10,ey0=e.y*TS-10,ex1=(e.x+e.w)*TS+10,ey1=(e.y+e.h)*TS+12;
  if(cx>=ex0&&cx<=ex1&&cy>=ey0&&cy<=ey1){const d=Math.hypot(cx-(e.x+e.w/2)*TS,cy-(e.y+e.h/2)*TS);if(d<bd){bd=d;best=e}}}
 if(best!==S.near){S.near=best;const p=$('prompt');if(best){p.innerHTML=promptText(best);p.hidden=false}else p.hidden=true}
 if(paused)$('prompt').hidden=true;else if(S.near)$('prompt').hidden=false;
 S.cam.x=Math.round(clamp(S.px+8-S.vw/2,0,MW*TS-S.vw));S.cam.y=Math.round(clamp(S.py+8-S.vh/2,0,MH*TS-S.vh));
 S.saveT=(S.saveT||0)+dt;if(S.saveT>12){S.saveT=0;persist()}}

